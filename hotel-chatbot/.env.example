# Use your own project URL and public anon key. Never use a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production: exact public HTTPS origin, no path.
SITE_URL=
# Required in production: generate a random signing secret of at least 32 characters.
HOTEL_CHAT_SESSION_SECRET=
# Optional AI fallback: production Chat URL from your n8n Chat Trigger.
HOTEL_CHAT_WEBHOOK_URL=
# Optional server-only value matching your n8n Basic Auth credential: username:password
HOTEL_CHAT_BASIC_AUTH=
